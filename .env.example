# ──────────────────────────────────────────────────
# Apymix — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs.
# ──────────────────────────────────────────────────

# Environnement : development | production
ENV=development
DEBUG=true

# Base de données
# Dev  : sqlite+aiosqlite:///./dev.db
# Prod : postgresql+asyncpg://user:password@db:5432/apymix
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# JWT — CHANGER IMPÉRATIVEMENT en production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:9000

# Logging : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# Préfixe des tables système Apymix (défaut: amx_)
# Prod avec tables existantes papi_* : AMX_TABLE_PREFIX=papi_
AMX_TABLE_PREFIX=amx_

# Backup S3 (optionnel, pour backup_and_upload)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=fr-par

# Notifications email (Resend, optionnel)
RESEND_API_KEY=

# Dev / CI — réinitialise la BDD et rejoue le seed au démarrage
FORCE_SEED=false
